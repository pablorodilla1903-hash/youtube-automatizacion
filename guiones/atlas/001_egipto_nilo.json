    },
    {
     "type": "big_number",
     "narration": "Cairo gets only around twenty-five millimeters of rain in an entire year. London gets more than twenty times that.",
     "data": {
      "kicker": "Rain per year in Cairo",
      "value": "25 mm",
      "caption": "London gets more than 20 times as much"
     }
    },
    {
     "type": "icon_grid",
     "narration": "So picture Egypt as one hundred squares of land. Only about five of them are green enough to live on and farm.",
     "data": {
      "icon": "circle",
      "icons": 100,
      "cols": 20,
      "highlight": 5,
      "label": "Egypt's land",
      "caption": "each dot = 1% of the country"
