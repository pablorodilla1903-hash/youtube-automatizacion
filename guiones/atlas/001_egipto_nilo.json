    },
    {
     "type": "map_route",
     "narration": "That's why the Nile does something that looks impossible on a map. It crosses well over a thousand kilometers of desert without a single major river joining it, and without drying up.",
     "data": {
      "bbox": [
       24,
       12,
       38,
       32
      ],
      "rivers": [
       {
        "names": [
         "Nile",
         "Atbara",
         "Blue Nile",
         "White Nile",
         "Rosetta Branch",
         "Damietta Branch"
        ],
        "width": 7
