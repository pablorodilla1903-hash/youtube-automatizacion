    },
    {
     "type": "icon_grid",
     "narration": "Now picture the people. About ninety-five out of every hundred Egyptians live on those five squares.",
     "data": {
      "icon": "person",
      "icons": 100,
      "cols": 20,
      "highlight": 95,
      "label": "Egypt's people",
