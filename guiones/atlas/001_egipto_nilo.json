    {
     "type": "versus",
     "narration": "Ancient Egyptians called their country Kemet, the black land, after that mud. The desert around it was Deshret, the red land. Life on one side. Death on the other.",
     "data": {
      "left": {
       "name": "Kemet",
       "lines": [
        "The black land",
        "Fertile Nile mud"
       ],
       "title_color": "green"
