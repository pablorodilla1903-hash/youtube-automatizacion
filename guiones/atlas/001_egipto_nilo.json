  {
   "n": 1,
   "title": "A country that's 95% empty",
   "title_youtube": "A country that's 95% empty",
   "scenes": [
    {
     "type": "text",
     "narration": "By the end of this video, you'll see why this strip gave birth to one of the first great civilizations, how Egypt moved an entire temple to save it, and why the river behind it all is now at the center of a conflict.",
     "data": {
      "kicker": "Coming up",
      "text": "A civilization, a moving temple and a new conflict",
      "highlight": [
       "civilization",
       "temple",
       "conflict"
      ]
     }
    },
    {
     "type": "map_route",
     "narration": "Take away the Nile, and Egypt is almost entirely desert. The Sahara covers nearly the whole country.",
     "data": {
      "bbox": [
       23.5,
       21.0,
       38.0,
       32.2
      ],
      "highlight_countries": [
       {
        "name": "Egypt",
